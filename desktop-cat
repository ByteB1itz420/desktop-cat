#!/usr/bin/env bash
# Desktop Cat launcher.
#   desktop-cat                 start the cats (if not already running)
#   desktop-cat menu|treat|pet|play|focus|pause|stop|hide|show   control the running cats (bind these to keys!)
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SOCK="${XDG_RUNTIME_DIR:-/tmp}/desktop-cat.sock"
if [ -n "$1" ]; then
  python3 -c 'import socket,sys; s=socket.socket(socket.AF_UNIX,socket.SOCK_DGRAM); s.sendto(sys.argv[2].encode(), sys.argv[1])' "$SOCK" "$1" \
    || { echo "Desktop Cat isn't running."; exit 1; }
  exit 0
fi
if pgrep -f "python3 -m catpet.app" >/dev/null; then echo "Desktop Cat is already running."; exit 0; fi
cd "$DIR" && exec python3 -m catpet.app
